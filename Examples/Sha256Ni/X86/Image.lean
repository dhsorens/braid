theorem sha256_compress_ni_lowered :
    sha256_compress_ni.blocks = Lowering.X86.lowerLines (Lowering.X86.labelsOf image) sha256_compress_ni_code := by
  decide

/-- The blocks of `sha256_compress_ni` are blocks of the lowering of the executable. -/
theorem sha256_compress_ni_holds :
    ∀ p ∈ sha256_compress_ni.blocks, Lowering.X86.lowerProgram exe p.1 = some p.2 :=
  Lowering.X86.holds_exeOf image_wf
    (fun _ h => List.mem_flatten.2 ⟨_, List.Mem.head _, h⟩) sha256_compress_ni_lowered


/-- `sha256_schedule` is the lowering of `sha256_schedule_code`. -/
theorem sha256_schedule_lowered :
    sha256_schedule.blocks = Lowering.X86.lowerLines (Lowering.X86.labelsOf image) sha256_schedule_code := by
  decide +kernel

/-- The blocks of `sha256_schedule` are blocks of the lowering of the executable. -/
theorem sha256_schedule_holds :
    ∀ p ∈ sha256_schedule.blocks, Lowering.X86.lowerProgram exe p.1 = some p.2 :=
  Lowering.X86.holds_exeOf image_wf
    (fun _ h => List.mem_flatten.2 ⟨_, List.Mem.tail _ (List.Mem.head _), h⟩) sha256_schedule_lowered


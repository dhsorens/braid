/-- `chacha20_block`, lowered to `braid`. -/
def chacha20_block : Braid.Func :=
  { name := "chacha20_block", entry := 0x401040#64, blocks :=
    chacha20_block_blocks_0 ++
    chacha20_block_blocks_1 }

/-- `chacha20_block` is the lowering of `chacha20_block_code`. -/
theorem chacha20_block_lowered :
    chacha20_block.blocks = Lowering.X86.lowerLines (Lowering.X86.labelsOf image) chacha20_block_code := by
  decide +kernel

/-- The blocks of `chacha20_block` are blocks of the lowering of the executable. -/
theorem chacha20_block_holds :
    ∀ p ∈ chacha20_block.blocks, Lowering.X86.lowerProgram exe p.1 = some p.2 :=
  Lowering.X86.holds_exeOf image_wf
    (fun _ h => List.mem_flatten.2 ⟨_, List.Mem.tail _ (List.Mem.head _), h⟩) chacha20_block_lowered

end Examples.ChaCha20.X86

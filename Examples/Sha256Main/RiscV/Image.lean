/-- The binary as it is loaded: its code, its sections and its entry point. -/
def sha256_main_image : Lowering.RiscV.Image :=
  { entry := 0x10468#64,
    code := sha256_compress_code ++ _start_code ++ main_code,
    data := [
      (0x10368#64, sha256_main_section_rodata),
      (0x10640#64, List.replicate 2048 0#8),
      (0x10e40#64, sha256_main_section_msglen),
      (0x10e48#64, sha256_main_section_msg)],
    zero := [] }

/-- The blocks of the whole program. -/
def sha256_main_blocks : List (Braid.Word × Braid.Block) :=
  sha256_compress.blocks ++ _start.blocks ++ main.blocks

/-- The blocks of the program are the lowering of the code of the image. -/
theorem sha256_main_lowered :
    sha256_main_blocks =
      sha256_main_image.code.map fun p => (p.1, Lowering.RiscV.lowerEnv p.1 p.2) := by
  simp only [sha256_main_blocks, sha256_main_image, List.map_append, sha256_compress_lowered, _start_lowered, main_lowered]

/-- The sections of the image do not overlap. -/
theorem sha256_main_apart : Braid.Sections.Apart sha256_main_image.sections := by
  decide +kernel

